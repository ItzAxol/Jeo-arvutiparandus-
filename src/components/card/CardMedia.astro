---
import { Image } from 'astro:assets';
import { cn } from '../../lib/utils.ts';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  className?: string;
  imgClassName?: string;
}

const { src, alt, className, imgClassName } = Astro.props;
---
<div
  data-slot="card-media"
  class={cn('overflow-hidden rounded-lg p-4', className)}
>
  <Image
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    class={cn('aspect-[16/10] w-full object-contain', imgClassName)}
  />
</div>
